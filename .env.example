# Copie para `.env.local` e ajuste conforme o seu ambiente.

# "true" usa o mock embutido e ignora o backend.
NEXT_PUBLIC_RAIO_X_MOCK=false

# Origem do backend vista pelo servidor Next (usada pelo proxy /api/rh/*).
# Casa: http://localhost:8000 · Servidor CT-THOTH: http://localhost:8010
BACKEND_URL=http://localhost:8000

# Tempo máximo de espera por resposta, em milissegundos.
# O recálculo forçado (atualizar=true) pode levar alguns segundos.
NEXT_PUBLIC_RAIO_X_TIMEOUT=20000
